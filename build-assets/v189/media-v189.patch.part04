   @override
   void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
     _mediaSubscription?.cancel();
     super.dispose();
   }
 
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.resumed) {
+      unawaited(_consumeSharedStation());
+      unawaited(_refreshMedia());
+    }
+  }
+
+  Future<void> _initializeCompanion() async {
+    await _loadSavedStations();
+    try {
+      final installed = await _companionApps
+              .invokeMethod<bool>('isRadioGardenInstalled') ??
+          false;
+      if (mounted) setState(() => _radioGardenInstalled = installed);
+    } catch (_) {
+      if (mounted) setState(() => _radioGardenInstalled = false);
+    }
+    await _consumeSharedStation();
+    await _refreshMedia();
+  }
+
+  Future<void> _loadSavedStations() async {
+    final raw = await _storage.read(key: _favoritesKey);
+    final lastRaw = await _storage.read(key: _lastStationKey);
+    final stations = <_SavedStation>[];
+    if (raw != null && raw.isNotEmpty) {
+      try {
+        final decoded = jsonDecode(raw);
+        if (decoded is List) {
+          for (final item in decoded.whereType<Map>()) {
+            final station = _SavedStation.fromMap(item);
+            if (station != null) stations.add(station);
+          }
+        }
+      } catch (_) {}
+    }
+    _SavedStation? last;
+    if (lastRaw != null && lastRaw.isNotEmpty) {
+      try {
+        final decoded = jsonDecode(lastRaw);
+        if (decoded is Map) last = _SavedStation.fromMap(decoded);
+      } catch (_) {}
+    }
+    if (!mounted) return;
+    setState(() {
+      _savedStations = stations.take(12).toList(growable: false);
+      _lastStation = last;
+    });
+  }
+
+  Future<void> _consumeSharedStation() async {
+    try {
+      final shared = await _companionApps.invokeMethod<String>('consumeRadioGardenShare');
+      if (shared == null || !_isStationUrl(shared)) return;
+      await _saveStation(shared, label: _title ?? _stationLabelFromUrl(shared));
+      if (mounted) setState(() => _message = 'STATION SAVED TO SC DRIVE');
+    } catch (_) {}
+  }
+
+  bool _isStationUrl(String value) {
+    final uri = Uri.tryParse(value);
+    return uri != null &&
+        uri.host.toLowerCase().endsWith('radio.garden') &&
+        uri.path.toLowerCase().contains('/listen/');
+  }
+
+  String _stationLabelFromUrl(String value) {
+    final uri = Uri.tryParse(value);
+    if (uri == null) return 'RADIO GARDEN';
+    final parts = uri.pathSegments.where((part) => part.isNotEmpty).toList();
+    final listen = parts.indexWhere((part) => part.toLowerCase() == 'listen');
+    if (listen >= 0 && listen + 1 < parts.length) {
+      return parts[listen + 1]
+          .replaceAll('-', ' ')
+          .split(' ')
+          .where((part) => part.isNotEmpty)
+          .map((part) => '${part[0].toUpperCase()}${part.substring(1)}')
+          .join(' ');
+    }
+    return 'RADIO GARDEN';
+  }
+
+  Future<void> _saveStation(String url, {required String label}) async {
+    if (!_isStationUrl(url)) return;
+    final station = _SavedStation(label: label.trim().isEmpty ? 'RADIO GARDEN' : label.trim(), url: url);
+    final next = <_SavedStation>[
+      station,
+      ..._savedStations.where((item) => item.url != url),
+    ].take(12).toList(growable: false);
+    await _storage.write(
+      key: _favoritesKey,
