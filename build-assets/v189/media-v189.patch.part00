@@ -88,6 +89,21 @@
 
     fun resume(): Boolean = start()
 
+    private fun spotifyWebUrl(value: String): String {
+        if (!value.startsWith("spotify:")) {
+            return if (value.startsWith("http://") || value.startsWith("https://")) value else "https://open.spotify.com"
+        }
+        val parts = value.split(":")
+        if (parts.size >= 3) {
+            val type = parts[1]
+            val id = parts[2]
+            if (type in setOf("track", "album", "artist", "playlist", "episode", "show") && id.isNotBlank()) {
+                return "https://open.spotify.com/$type/$id"
+            }
+        }
+        return "https://open.spotify.com"
+    }
+
     fun destroy() {
         bindController(null)
         stopSessionListener()
@@ -154,6 +170,29 @@
         }
     }
 
+    fun openSpotify(uri: String?): Boolean {
+        val requested = uri?.trim().orEmpty()
+        val target = spotifyWebUrl(requested)
+        val intent = Intent(Intent.ACTION_VIEW, Uri.parse(target)).apply {
+            setPackage(SPOTIFY_PACKAGE)
+            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP)
+        }
+        return try {
+            context.startActivity(intent)
+            true
+        } catch (_: Exception) {
+            try {
+                val launch = context.packageManager.getLaunchIntentForPackage(SPOTIFY_PACKAGE)
+                    ?: return false
+                launch.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP)
+                context.startActivity(launch)
+                true
+            } catch (_: Exception) {
+                false
+            }
+        }
+    }
+
     override fun onActiveSessionsChanged(controllers: MutableList<MediaController>?) {
         selectSpotifyController(controllers.orEmpty())
     }
