+class _SavedStation {
+  const _SavedStation({required this.label, required this.url});
+  final String label;
+  final String url;
+
+  Map<String, String> toMap() => <String, String>{'label': label, 'url': url};
+
+  static _SavedStation? fromMap(Map<dynamic, dynamic> map) {
+    final label = map['label']?.toString().trim();
+    final url = map['url']?.toString().trim();
+    if (label == null || label.isEmpty || url == null || url.isEmpty) return null;
+    return _SavedStation(label: label, url: url);
+  }
+}
