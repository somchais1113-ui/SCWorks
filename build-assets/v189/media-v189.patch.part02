+  Future<bool> openSpotify({String? spotifyUri, String? url}) async {
+    final target = spotifyUri ?? _spotifyUriFromWebUrl(url) ?? 'spotify:';
+    if (defaultTargetPlatform != TargetPlatform.android) {
+      _errorMessage = 'Spotify direct-app launch is available on Android.';
+      notifyListeners();
+      return false;
+    }
+    try {
+      final opened = await _spotifyMediaControl.invokeMethod<bool>(
+            'openSpotify',
+            <String, Object?>{'uri': target},
+          ) ??
+          false;
+      if (!opened) {
+        _errorMessage = 'Spotify app is not installed on this head unit.';
+        notifyListeners();
+      }
+      return opened;
+    } on PlatformException catch (error) {
+      _errorMessage = error.message ?? 'Unable to open Spotify app.';
+      notifyListeners();
+      return false;
+    } on MissingPluginException {
+      _errorMessage = 'Spotify app launcher is not available.';
+      notifyListeners();
+      return false;
+    }
+  }
