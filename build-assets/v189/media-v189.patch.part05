+      key: _favoritesKey,
+      value: jsonEncode(next.map((item) => item.toMap()).toList()),
+    );
+    await _storage.write(key: _lastStationKey, value: jsonEncode(station.toMap()));
+    if (!mounted) return;
+    setState(() {
+      _savedStations = next;
+      _lastStation = station;
+    });
+  }
