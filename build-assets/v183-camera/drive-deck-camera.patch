+class _CameraAlertOverlay extends StatelessWidget {
+  const _CameraAlertOverlay({
+    required this.snapshot,
+    required this.compact,
+  });
+
+  final CameraAlertSnapshot snapshot;
+  final bool compact;
+
+  @override
+  Widget build(BuildContext context) {
+    final camera = snapshot.camera;
+    if (camera == null) return const SizedBox.shrink();
+
+    final visible = snapshot.phase != CameraAlertPhase.entering &&
+        snapshot.phase != CameraAlertPhase.exiting &&
+        snapshot.phase != CameraAlertPhase.hidden;
+    final distance = snapshot.displayDistanceMeters.isFinite
+        ? snapshot.displayDistanceMeters.clamp(0.0, 9999.0).round()
+        : 0;
+    final limit = camera.speedLimitKph;
+    final nowSpeed = snapshot.vehicleSpeedKph.round();
+    final overLimit = limit != null && nowSpeed > limit;
+    final near = snapshot.phase == CameraAlertPhase.near || distance <= 150;
+    final accent = near ? const Color(0xFFFF4D4D) : const Color(0xFFFF6B35);
+
+    return IgnorePointer(
+      child: AnimatedSlide(
+        duration: const Duration(milliseconds: 320),
+        curve: Curves.easeOutCubic,
+        offset: visible ? Offset.zero : const Offset(1.18, 0),
+        child: AnimatedOpacity(
+          duration: const Duration(milliseconds: 220),
+          opacity: visible ? 1 : 0,
+          child: Container(
+            width: compact ? 168 : 208,
+            padding: EdgeInsets.fromLTRB(
+              compact ? 12 : 15,
+              compact ? 10 : 12,
+              compact ? 12 : 15,
+              compact ? 9 : 11,
+            ),
+            decoration: BoxDecoration(
+              color: const Color(0xED101419),
+              borderRadius: BorderRadius.circular(compact ? 13 : 16),
+              border: Border.all(color: accent.withAlpha(209)),
+              boxShadow: const <BoxShadow>[
+                BoxShadow(
+                  color: Color(0x66000000),
+                  blurRadius: 16,
+                  offset: Offset(0, 7),
+                ),
+              ],
+            ),
+            child: Column(
+              mainAxisSize: MainAxisSize.min,
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: <Widget>[
+                Row(
+                  children: <Widget>[
+                    Container(
+                      width: compact ? 7 : 8,
+                      height: compact ? 7 : 8,
+                      decoration: BoxDecoration(
+                        color: accent,
+                        shape: BoxShape.circle,
+                      ),
+                    ),
+                    const SizedBox(width: 7),
+                    Text(
+                      snapshot.phase == CameraAlertPhase.passed
+                          ? 'CAMERA PASSED'
+                          : 'CAMERA AHEAD',
+                      style: TextStyle(
+                        color: Colors.white,
+                        fontSize: compact ? 9.5 : 11.5,
+                        fontWeight: FontWeight.w900,
+                        letterSpacing: 0.8,
+                      ),
+                    ),
+                  ],
+                ),
+                SizedBox(height: compact ? 4 : 6),
+                Text(
+                  '$distance m',
+                  style: TextStyle(
+                    color: Colors.white,
+                    fontSize: compact ? 27 : 34,
+                    height: 0.95,
+                    fontWeight: FontWeight.w700,
+                    letterSpacing: -1.2,
+                  ),
+                ),
+                SizedBox(height: compact ? 8 : 10),
+                Row(
+                  children: <Widget>[
+                    Expanded(
+                      child: _CameraMetric(
+                        label: 'LIMIT',
+                        value: limit?.toString() ?? '--',
+                        compact: compact,
+                      ),
+                    ),
+                    Expanded(
+                      child: _CameraMetric(
+                        label: 'NOW',
+                        value: nowSpeed.toString(),
+                        compact: compact,
+                        emphasized: overLimit,
+                      ),
+                    ),
+                  ],
+                ),
+              ],
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
